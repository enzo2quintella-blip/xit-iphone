{
  "_comment": "Template de config de offsets. Copie para offsets_<BUILD_UUID>.json e preencha os valores.",
  "_how_to_find": {
    "build_uuid": "python3 -c \"import struct,sys; d=open('GameAssembly.dylib','rb').read(); i=d.find(b'\\x1b\\x00\\x00\\x00'); h=d[i+8:i+24].hex(); print(f'{h[0:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:32]}')\"",
    "GameAssembly_exports": "Todos il2cpp_* são exports diretos — use 'nm -gU GameAssembly.dylib | grep il2cpp'",
    "klass_*": "Il2CppDumper → script.json → procura 'PlayerInfo' → pega 'Address' (é o RVA do Il2CppClass*)",
    "fn_*": "Il2CppDumper → dump.cs → busca classe e método → pega o RVA no comentário '// RVA: 0x...'",
    "struct_fields": "Il2CppDumper → dump.cs → no bloco da classe, cada campo tem '// 0xOFFSET' antes da declaração"
  },

  "build_uuid": "PREENCHA-COM-UUID-DO-GAMEASSEMBLY",
  "game_version": [0, 0, 0],

