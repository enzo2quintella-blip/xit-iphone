<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Entitlement chave do DOPE para acesso ao container de outros apps -->
    <key>com.dash.patcher.containeraccess</key>
    <true/>

    <!-- Permite acesso ao container via MobileHouseArrest -->
    <key>get-task-allow</key>
    <true/>

    <!-- Marca como app de plataforma -->
    <key>platform-application</key>
    <true/>

    <!-- Pula validação de library — necessário para usar dylibs privados -->
    <key>com.apple.private.skip-library-validation</key>
    <true/>

    <!-- Sem container próprio — precisa escrever no container de outros apps -->
    <key>com.apple.private.security.no-container</key>
    <true/>

    <!-- Sem sandbox — precisa acessar /private/var/mobile/Containers -->
    <key>com.apple.private.security.no-sandbox</key>
    <true/>

    <!-- Permite listar e acessar containers de apps instalados -->
    <key>com.apple.private.MobileContainerManager.allowed</key>
    <true/>

    <!-- Permite task_for_pid(0) para acesso ao kernel task port -->
    <key>com.apple.private.security.developer-mode</key>
    <true/>

    <!-- IOSurface com páginas wired para o exploit -->
    <key>com.apple.private.iosurface.client</key>
    <true/>
</dict>
</plist>
